# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Sender identity (used in every email) ---
SENDER_NAME=Mykyta Lysenko
SENDER_EMAIL=hello@smuz.io
SENDER_COMPANY=Smuz
SENDER_BOOKING_URL=https://smuz.io/#cta
SENDER_REPLY_TO=hello@smuz.io

# The registered identity of the data controller, on one line, exactly as it
# appears in the privacy policy and in client contracts. A real send REFUSES
# without it: a commercial email to a named person has to carry the sender's
# registered name and postal address, and a run that cheerfully sent 15
# unlawful emails would look, in the numbers, like a healthy day.
# Dry runs do not need it.
SENDER_POSTAL_ADDRESS=
PRIVACY_POLICY_URL=https://smuz.io/privacy
# Where opt-out replies are read. Defaults to SENDER_REPLY_TO.
UNSUBSCRIBE_EMAIL=

# --- Email transport (pick ONE) ---
# Option A: Resend (recommended). Get a key at resend.com
RESEND_API_KEY=

# Option B: Gmail / Google Workspace SMTP. Use an app password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Reading what came back (replies, bounces, opt-outs) ---
# Same mailbox as SENDER_REPLY_TO in the normal case. Use a Workspace app
# password, never the account password. `python -m outbound ingest-replies`
# records replies and honours opt-outs the moment it sees them.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Optional enrichment ---
# Hunter.io for email-finding (50 free verifications/mo). Leave blank to fall back to pattern guessing.
HUNTER_API_KEY=

# ProductHunt API token (optional — RSS feed used as fallback). https://api.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=

# Apollo.io API key (free tier works — sign up at apollo.io, then Settings → Integrations → API).
# The agent only uses search (no per-call credits). It uses an email only when Apollo returns it
# as 'verified' for free; locked emails fall back to pattern-guessing — no credits burned.
APOLLO_API_KEY=

# --- Limits & safety ---
# Countries whose national law requires prior CONSENT for unsolicited
# commercial email, so we do not send there: Poland (PKE), Germany and Austria
# (UWG), Canada (CASL) and Australia (Spam Act). Consent-vs-opt-out is not an
# EU/non-EU line, which is how CA and AU were missed until 7 Sep 2026. The UK
# (PECR, corporate-subscriber exemption) and the US (CAN-SPAM, opt-out) are
# workable. A lead with no recorded country is refused too. Removing a country
# from this list is a legal decision — see outbound/jurisdiction.py.
MARKETING_EXCLUDED_COUNTRIES=PL,DE,AT,CA,AU

# The published self-audit. Leave EMPTY until the repo is genuinely public —
# the prompt links it only when set, because a 404 in a cold email is worse
# than no link at all.
AUDIT_URL=

# The researched cohort. Gitignored and machine-local, so the path is
# configurable rather than assumed; the 'targets' discovery source reads it.
# Rows without a country or a website are held back, never guessed at.
TARGETS_CSV=./targets.csv

DAILY_SEND_CAP=25
DRY_RUN=true
DB_PATH=./outbound.db
