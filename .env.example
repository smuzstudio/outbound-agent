# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Sender identity (used in every email) ---
SENDER_NAME=Mykyta Lysenko
SENDER_EMAIL=hello@smuz.io
SENDER_COMPANY=Smuz
SENDER_BOOKING_URL=https://smuz.io/#cta
SENDER_REPLY_TO=hello@smuz.io

# --- Email transport (pick ONE) ---
# Option A: Resend (recommended). Get a key at resend.com
RESEND_API_KEY=

# Option B: Gmail / Google Workspace SMTP. Use an app password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Optional enrichment ---
# Hunter.io for email-finding (50 free verifications/mo). Leave blank to fall back to pattern guessing.
HUNTER_API_KEY=

# ProductHunt API token (optional — RSS feed used as fallback). https://api.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=

# Apollo.io API key (free tier works — sign up at apollo.io, then Settings → Integrations → API).
# The agent only uses search (no per-call credits). It uses an email only when Apollo returns it
# as 'verified' for free; locked emails fall back to pattern-guessing — no credits burned.
APOLLO_API_KEY=

# --- Limits & safety ---
DAILY_SEND_CAP=25
DRY_RUN=true
DB_PATH=./outbound.db
